{
  "expo": {
    "name": "Surf Health",
    "slug": "surf-health",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "surfhealth",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b4266"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.surfhealth.app"
    },
    "android": {
      "package": "com.surfhealth.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b4266"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ed1bb99-5179-4a04-8073-55e0ecb03bfb"
      }
    }
  }
}
