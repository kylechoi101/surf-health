{
  "expo": {
    "name": "Shorelife",
    "slug": "surf-health",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "shorelife",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b4266"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shorelife.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Used to sort nearby beaches by distance."
      }
    },
    "android": {
      "package": "com.shorelife.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to sort nearby beaches by distance."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ed1bb99-5179-4a04-8073-55e0ecb03bfb"
      }
    }
  }
}
